@model IEnumerable<E_CommerceSite.Models.Order>

@{
    ViewData["Title"] = "Pedidos";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="mb-1">Pedidos</h2>

        <p class="text-muted mb-0">
            Administración y seguimiento de pedidos
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        + Nuevo pedido
    </a>

</div>

<!-- Tarjetas informativas -->

<div class="row g-3 mb-4">

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-2">Total de pedidos</p>

                <h3 class="fw-bold mb-0">
                    @Model.Count()
                </h3>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-2">Pendientes</p>

                <h3 class="fw-bold text-warning mb-0">
                    @Model.Count(order => order.Status == "Pendiente")
                </h3>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-2">Completados</p>

                <h3 class="fw-bold text-success mb-0">
                    @Model.Count(order => order.Status == "Completado")
                </h3>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-2">Ingresos</p>

                <h3 class="fw-bold text-primary mb-0">
                    RD$ @Model.Where(order => order.Status == "Completado").Sum(order => order.Total).ToString("N2")
                </h3>
            </div>
        </div>
    </div>

</div>

<!-- Tabla de pedidos -->

<div class="card border-0 shadow-sm">

    <div class="card-header bg-white py-3">
        <h5 class="mb-0">Lista de pedidos</h5>
    </div>

    <div class="card-body">

        <div class="table-responsive">

            <table id="ordersTable"
                   class="table table-striped table-hover align-middle w-100">

                <thead class="table-dark">
                    <tr>
                        <th>Número</th>
                        <th>Cliente</th>
                        <th>Fecha</th>
                        <th>Total</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="fw-semibold">
                                #@order.Id
                            </td>

                            <td>
                                @order.Customer?.Name
                            </td>

                            <td data-order="@order.OrderDate.ToString("yyyy-MM-dd HH:mm:ss")">
                                @order.OrderDate.ToString("dd/MM/yyyy hh:mm tt")
                            </td>

                            <td data-order="@order.Total">
                                RD$ @order.Total.ToString("N2")
                            </td>

                            <td>
                                @if (order.Status == "Pendiente")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pendiente
                                    </span>
                                }
                                else if (order.Status == "Procesando")
                                {
                                    <span class="badge bg-info text-dark">
                                        Procesando
                                    </span>
                                }
                                else if (order.Status == "Enviado")
                                {
                                    <span class="badge bg-primary">
                                        Enviado
                                    </span>
                                }
                                else if (order.Status == "Completado")
                                {
                                    <span class="badge bg-success">
                                        Completado
                                    </span>
                                }
                                else if (order.Status == "Cancelado")
                                {
                                    <span class="badge bg-danger">
                                        Cancelado
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @order.Status
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="d-flex justify-content-center gap-1">

                                    <a asp-action="Details"
                                       asp-route-id="@order.Id"
                                       class="btn btn-sm btn-outline-info">
                                        Ver
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@order.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Cambiar estado
                                    </a>

                                </div>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {

            new DataTable("#ordersTable", {

                pageLength: 10,

                lengthMenu: [5, 10, 25, 50, 100],

                // Pedidos más recientes primero
                order: [[2, "desc"]],

                columnDefs: [
                    {
                        // No ordenar ni buscar en Acciones
                        targets: 5,
                        orderable: false,
                        searchable: false
                    }
                ],

                stateSave: true,

                language: {
                    search: "Buscar:",
                    searchPlaceholder: "Número, cliente o estado...",

                    lengthMenu: "Mostrar _MENU_ pedidos",

                    info: "Mostrando _START_ a _END_ de _TOTAL_ pedidos",

                    infoEmpty: "No hay pedidos registrados",

                    infoFiltered: "(filtrado de _MAX_ pedidos)",

                    zeroRecords: "No se encontraron pedidos",

                    emptyTable: "No hay pedidos disponibles",

                    paginate: {
                        first: "Primero",
                        previous: "Anterior",
                        next: "Siguiente",
                        last: "Último"
                    }
                }
            });

        });
    </script>
}
