@using E_CommerceSite.Datos.OrderNameSpace
@model OrderDetailsViewModel


@{
    ViewData["Title"] = "Pedidos";
}

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div id="deleteAlert"
         class="alert alert-success alert-dismissible fade show"
         role="alert">

        <strong>¡Listo!</strong> @successMessage

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Cerrar">
        </button>
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div id="deleteAlert"
         class="alert alert-danger alert-dismissible fade show"
         role="alert">

        <strong>¡Error!</strong> @errorMessage

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Cerrar">
        </button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="mb-1">Pedidos</h2>

        <p class="text-muted mb-0">
            Administración y seguimiento de pedidos
        </p>
    </div>

    @* <a asp-action="Create"
       class="btn btn-primary">
        + Nuevo pedido
    </a> *@
    <button type="button"
            class="btn btn-primary"
            data-bs-toggle="modal"
            data-bs-target="#createOrderModal">
        + Nuevo pedido
    </button>

</div>

<!-- Tarjetas informativas -->

<div class="row g-3 mb-4">

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-2">Total de pedidos</p>

                <h3 class="fw-bold mb-0">
                    @Model.OrderList.Count()
                </h3>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-2">Pendientes</p>

                <h3 class="fw-bold text-warning mb-0">
                    @Model.OrderList.Count(order => order.Status == OrderStatus.Pending)
                </h3>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-2">Completados</p>

                <h3 class="fw-bold text-success mb-0">
                    @Model.OrderList.Count(order => order.Status == OrderStatus.Completed)
                </h3>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-2">Ingresos</p>

                <h3 class="fw-bold text-primary mb-0">
                    RD$ @Model.OrderList.Where(order => order.Status == OrderStatus.Completed).Sum(order => order.Total).ToString("N2")
                </h3>
            </div>
        </div>
    </div>

</div>

<!-- Tabla de pedidos -->

<div class="card border-0 shadow-sm">

    <div class="card-header bg-white py-3">
        <h5 class="mb-0">Lista de pedidos</h5>
    </div>

    <div class="card-body">

        <div class="table-responsive">

            <table id="ordersTable"
                   class="table table-striped table-hover align-middle w-100">

                <thead class="table-dark">
                    <tr>
                        <th>Número</th>
                        <th>Cliente</th>
                        <th>Fecha</th>
                        <th>Total</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var order in Model.OrderList)
                    {
                        <tr>
                            <td class="fw-semibold">
                                @(string.IsNullOrWhiteSpace(order.OrderNumber) ? order.Id.ToString() : order.OrderNumber)
                            </td>

                            <td>
                                @order.Customers.Name
                            </td>

                            <td data-order="@order.OrderDate.ToString("yyyy-MM-dd HH:mm:ss")">
                                @order.OrderDate.ToString("dd/MM/yyyy hh:mm tt")
                            </td>

                            <td data-order="@order.Total">
                                RD$ @order.Total.ToString("N2")
                            </td>

                            <td>
                                @if (order.Status == OrderStatus.Pending)
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pendiente
                                    </span>
                                }
                                else if (order.Status == OrderStatus.Processing)
                                {
                                    <span class="badge bg-info text-dark">
                                        Procesando
                                    </span>
                                }
                                else if (order.Status == OrderStatus.Shipped)
                                {
                                    <span class="badge bg-primary">
                                        Enviado
                                    </span>
                                }
                                else if (order.Status == OrderStatus.Completed)
                                {
                                    <span class="badge bg-success">
                                        Completado
                                    </span>
                                }
                                else if (order.Status == OrderStatus.Cancelled)
                                {
                                    <span class="badge bg-danger">
                                        Cancelado
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @order.Status
                                    </span>
                                }
                            </td>

                            <td>
                                <partial name="OrderActions" model="order" />
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<partial name="DetailsModal" />
<partial name="OrderModals" />
<partial name="CreateOrderModal" model="Model" />

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {

            new DataTable("#ordersTable", {

                pageLength: 10,

                lengthMenu: [5, 10, 25, 50, 100],

                // Pedidos más recientes primero
                order: [[2, "desc"]],

                columnDefs: [
                    {
                        // No ordenar ni buscar en Acciones
                        targets: 5,
                        orderable: false,
                        searchable: false
                    }
                ],

                stateSave: true,

                language: {
                    search: "Buscar:",
                    searchPlaceholder: "Número, cliente o estado...",

                    lengthMenu: "Mostrar _MENU_ pedidos",

                    info: "Mostrando _START_ a _END_ de _TOTAL_ pedidos",

                    infoEmpty: "No hay pedidos registrados",

                    infoFiltered: "(filtrado de _MAX_ pedidos)",

                    zeroRecords: "No se encontraron pedidos",

                    emptyTable: "No hay pedidos disponibles",

                    paginate: {
                        first: "Primero",
                        previous: "Anterior",
                        next: "Siguiente",
                        last: "Último"
                    }
                }
            });



            // Detalle, cambio de estado y confirmación de eliminación.
            const modal = document.getElementById("orderDetailsModal");
            const loading = document.getElementById("orderDetailsLoading");
            const content = document.getElementById("orderDetailsContent");
            const error = document.getElementById("orderDetailsError");
            const productsBody = document.getElementById("orderProductsBody");
            const deleteButton = document.getElementById("openDeleteOrderConfirmation");
            const editElement = document.getElementById("editOrderModal");
            const confirmationElement = document.getElementById("confirmDeleteOrderModal");
            const deleteForm = document.getElementById("deleteOrderForm");
            const deleteSubmit = document.getElementById("confirmDeleteOrderSubmit");

            const infoModal = bootstrap.Modal.getOrCreateInstance(modal);
            const confirmationModal = bootstrap.Modal.getOrCreateInstance(confirmationElement);
            const detailsUrl = '@Url.Action("Details", "Orders")';
            const moneyFormat = new Intl.NumberFormat("es-DO", {
                style: "currency",
                currency: "DOP"
            });

            //Deshabilitamos el boton de crear cuando este ya ha sido precionado para evitar duplicados
            const form = document.getElementById("createOrderForm");
            const button = document.getElementById("createOrderSubmit");
            
            form.addEventListener("submit", function () {
                button.disabled = true;
                button.textContent = "Guardando...";
            });



            let selectedOrder = null;
            let detailsRequest = null;
            let openConfirmationAfterHide = false;
            let deleteSubmitted = false;

            function readOrder(button) {
                const source = button?.closest(".order-actions");
                if (!source?.dataset.orderId) return null;

                return {
                    id: source.dataset.orderId,
                    orderNumber: source.dataset.orderNumber || source.dataset.orderId,
                    status: source.dataset.orderStatus || "",
                    customerName: source.dataset.customerName || "Sin cliente"
                };
            }

            modal.addEventListener("show.bs.modal", async function(event) {
                const order = readOrder(event.relatedTarget);

                // Al volver desde la confirmación se conserva el detalle cargado.
                if (!order) {
                    if (!selectedOrder) event.preventDefault();
                    return;
                }

                selectedOrder = order;
                detailsRequest?.abort();
                const request = new AbortController();
                detailsRequest = request;

                document.getElementById("orderDetailsNumber").textContent = order.orderNumber;
                loading.classList.remove("d-none");
                content.classList.add("d-none");
                error.classList.add("d-none");
                productsBody.replaceChildren();
                deleteButton.disabled = true;

                try {
                    const url = new URL(detailsUrl, window.location.href);
                    url.searchParams.set("id", order.id);
                    const response = await fetch(url, {
                        signal: request.signal,
                        headers: { Accept: "application/json" }
                    });
                    if (!response.ok) throw new Error("No se pudo cargar el pedido.");

                    const details = await response.json();
                    if (request.signal.aborted) return;

                    selectedOrder = {
                        ...order,
                        orderNumber: details.orderNumber || order.orderNumber,
                        customerName: details.customerName || order.customerName,
                        status: details.status
                    };

                    document.getElementById("orderDetailsNumber").textContent = selectedOrder.orderNumber;
                    document.getElementById("orderCustomerName").textContent = selectedOrder.customerName;
                    document.getElementById("orderCustomerEmail").textContent = details.customerEmail || "No especificado";
                    document.getElementById("orderCustomerPhone").textContent = details.customerPhone || "No especificado";
                    document.getElementById("orderCustomerAddress").textContent = details.customerAddress || "No especificada";
                    document.getElementById("orderDate").textContent =
                        new Date(details.orderDate).toLocaleString("es-DO");

                    configureStatus(details.status);
                    document.getElementById("orderSubtotal").textContent = moneyFormat.format(details.subtotal);
                    document.getElementById("orderDiscount").textContent = moneyFormat.format(details.discount);
                    document.getElementById("orderTax").textContent = moneyFormat.format(details.tax);
                    document.getElementById("orderTotal").textContent = moneyFormat.format(details.total);
                    showProducts(details.products);

                    loading.classList.add("d-none");
                    content.classList.remove("d-none");
                    deleteButton.disabled = false;
                } catch (exception) {
                    if (request.signal.aborted) return;
                    loading.classList.add("d-none");
                    error.classList.remove("d-none");
                } finally {
                    if (detailsRequest === request) detailsRequest = null;
                }
            });

            deleteButton.addEventListener("click", function() {
                if (!selectedOrder || deleteButton.disabled || openConfirmationAfterHide) return;
                openConfirmationAfterHide = true;
                infoModal.hide();
            });

            modal.addEventListener("shown.bs.modal", function() {
                if (openConfirmationAfterHide) infoModal.hide();
            });

            modal.addEventListener("hidden.bs.modal", function() {
                detailsRequest?.abort();
                detailsRequest = null;

                if (openConfirmationAfterHide) {
                    openConfirmationAfterHide = false;
                    confirmationModal.show();
                }
            });

            confirmationElement.addEventListener("show.bs.modal", function(event) {
                if (!selectedOrder) {
                    event.preventDefault();
                    return;
                }

                document.getElementById("deleteOrderId").value = selectedOrder.id;
                document.getElementById("orderDeleteNumber").textContent = selectedOrder.orderNumber;
                deleteSubmitted = false;
                deleteSubmit.disabled = false;
            });

            confirmationElement.addEventListener("hidden.bs.modal", function() {
                if (!deleteSubmitted && selectedOrder) infoModal.show();
            });

            editElement.addEventListener("show.bs.modal", function(event) {
                const order = readOrder(event.relatedTarget);
                if (!order) {
                    event.preventDefault();
                    return;
                }

                document.getElementById("editOrderForm").reset();
                document.getElementById("editOrderId").value = order.id;
                document.getElementById("editOrderNumber").textContent = order.orderNumber;
                document.getElementById("editOrderCustomer").textContent = order.customerName;
                document.getElementById("editOrderStatus").value = order.status;
            });

            deleteForm.addEventListener("submit", function(event) {
                if (event.defaultPrevented) return;
                if (!document.getElementById("deleteOrderId").value || deleteSubmitted) {
                    event.preventDefault();
                    return;
                }

                deleteSubmitted = true;
                deleteSubmit.disabled = true;
            });

            function showProducts(products) {
                productsBody.replaceChildren();

                if (!products || products.length === 0) {
                    const row = document.createElement("tr");
                    const cell = document.createElement("td");
                    cell.colSpan = 4;
                    cell.className = "text-center text-muted";
                    cell.textContent = "Este pedido no contiene productos.";
                    row.appendChild(cell);
                    productsBody.appendChild(row);
                    return;
                }

                products.forEach(function(product) {
                    const row = document.createElement("tr");
                    addCell(row, product.name);
                    addCell(row, moneyFormat.format(product.unitPrice), "text-end");
                    addCell(row, product.quantity, "text-center");
                    addCell(row, moneyFormat.format(product.subtotal), "text-end fw-semibold");
                    productsBody.appendChild(row);
                });
            }

            function addCell(row, value, className = "") {
                const cell = document.createElement("td");
                cell.textContent = value;
                cell.className = className;
                row.appendChild(cell);
            }

            function configureStatus(value) {
                const status = document.getElementById("orderStatus");
                const normalized = String(value).toLowerCase();
                const translations = {
                    pending: "Pendiente",
                    processing: "Procesando",
                    shipped: "Enviado",
                    completed: "Completado",
                    cancelled: "Cancelado"
                };
                const classes = {
                    pending: "badge bg-warning text-dark",
                    processing: "badge bg-primary",
                    shipped: "badge bg-info text-dark",
                    completed: "badge bg-success",
                    cancelled: "badge bg-danger"
                };
                status.textContent = translations[normalized] || value;
                status.className = classes[normalized] || "badge bg-secondary";
            }

            //create modal
            const createOrderForm =
                document.getElementById("createOrderForm");

            const productsTableElement =
                document.getElementById("createOrderProductsTable");

            const hiddenInputsContainer =
                document.getElementById("selectedOrderProductsInputs");

            const productError =
                document.getElementById("createOrderProductError");

            const orderTotal =
                document.getElementById("createOrderTotal");

            const createOrderModal =
                document.getElementById("createOrderModal");

            if (!createOrderForm || !productsTableElement) {
                return;
            }

            /*
             * Guarda los productos seleccionados aunque el usuario
             * cambie de página o realice una búsqueda en DataTables.
             */
            const selectedOrderProducts = new Map();

            const createOrderMoneyFormat = new Intl.NumberFormat(
                "es-DO",
                {
                    style: "currency",
                    currency: "DOP"
                }
            );

            /*
             * Evita inicializar la misma tabla dos veces.
             */
            const productsDataTable =
                $.fn.dataTable.isDataTable(productsTableElement)
                    ? $(productsTableElement).DataTable()
                    : $(productsTableElement).DataTable({
                        pageLength: 5,

                        lengthMenu: [5, 10, 25],

                        order: [[1, "asc"]],

                        columnDefs: [
                            {
                                targets: [0, 4, 5],
                                orderable: false,
                                searchable: false
                            }
                        ],

                        language: {
                            lengthMenu: "Mostrar _MENU_ productos",
                            zeroRecords: "No se encontraron productos",
                            info: "Mostrando _START_ a _END_ de _TOTAL_ productos",
                            infoEmpty: "No hay productos disponibles",
                            infoFiltered: "(filtrado de _MAX_ productos)",
                            search: "Buscar:",
                            paginate: {
                                first: "Primero",
                                previous: "Anterior",
                                next: "Siguiente",
                                last: "Último"
                            }
                        }
                    });

            /*
             * Seleccionar o quitar un producto.
             */
            $(productsTableElement).on(
                "change",
                ".order-product-selector",
                function () {
                    const checkbox = this;
                    const row = checkbox.closest("tr");

                    const quantityInput =
                        row.querySelector(".order-product-quantity");

                    const productId =
                        checkbox.dataset.productId;

                    const price =
                        Number(checkbox.dataset.price);

                    const stock =
                        Number(checkbox.dataset.stock);

                    if (checkbox.checked) {
                        if (stock <= 0) {
                            checkbox.checked = false;

                            productError.textContent =
                                "Este producto no tiene existencia disponible.";

                            productError.classList.remove("d-none");

                            return;
                        }

                        quantityInput.disabled = false;
                        quantityInput.value = 1;

                        selectedOrderProducts.set(
                            productId,
                            {
                                id: productId,
                                price: price,
                                stock: stock,
                                quantity: 1
                            }
                        );
                    }
                    else {
                        quantityInput.disabled = true;
                        quantityInput.value = 1;

                        selectedOrderProducts.delete(productId);
                    }

                    productError.classList.add("d-none");

                    updateVisibleProductRow(row);
                    updateCreateOrderTotal();
                }
            );

            /*
             * Actualizar cantidad seleccionada.
             */
            $(productsTableElement).on(
                "input",
                ".order-product-quantity",
                function () {
                    const quantityInput = this;
                    const row = quantityInput.closest("tr");

                    const checkbox =
                        row.querySelector(".order-product-selector");

                    if (!checkbox.checked) {
                        return;
                    }

                    const productId =
                        checkbox.dataset.productId;

                    const selectedProduct =
                        selectedOrderProducts.get(productId);

                    if (!selectedProduct) {
                        return;
                    }

                    selectedProduct.quantity =
                        Number(quantityInput.value);

                    productError.classList.add("d-none");

                    updateVisibleProductRow(row);
                    updateCreateOrderTotal();
                }
            );

            /*
             * Restaurar selecciones después de buscar,
             * ordenar o cambiar de página.
             */
            $(productsTableElement).on(
                "draw.dt",
                function () {
                    restoreVisibleProducts();
                }
            );

            function restoreVisibleProducts() {
                const visibleRows =
                    productsTableElement.querySelectorAll("tbody tr");

                visibleRows.forEach(function (row) {
                    const checkbox =
                        row.querySelector(".order-product-selector");

                    if (!checkbox) {
                        return;
                    }

                    const quantityInput =
                        row.querySelector(".order-product-quantity");

                    const productId =
                        checkbox.dataset.productId;

                    const selectedProduct =
                        selectedOrderProducts.get(productId);

                    if (selectedProduct) {
                        checkbox.checked = true;
                        quantityInput.disabled = false;
                        quantityInput.value =
                            selectedProduct.quantity;
                    }
                    else {
                        checkbox.checked = false;
                        quantityInput.disabled = true;
                        quantityInput.value = 1;
                    }

                    updateVisibleProductRow(row);
                });
            }

            function updateVisibleProductRow(row) {
                const checkbox =
                    row.querySelector(".order-product-selector");

                const subtotalElement =
                    row.querySelector(".order-product-subtotal");

                if (!checkbox || !subtotalElement) {
                    return;
                }

                const selectedProduct =
                    selectedOrderProducts.get(
                        checkbox.dataset.productId
                    );

                let subtotal = 0;

                if (
                    selectedProduct &&
                    Number.isInteger(selectedProduct.quantity) &&
                    selectedProduct.quantity >= 1 &&
                    selectedProduct.quantity <= selectedProduct.stock
                ) {
                    subtotal =
                        selectedProduct.price *
                        selectedProduct.quantity;
                }

                subtotalElement.textContent =
                    createOrderMoneyFormat.format(subtotal);
            }

            function updateCreateOrderTotal() {
                let total = 0;

                selectedOrderProducts.forEach(
                    function (product) {
                        if (
                            Number.isInteger(product.quantity) &&
                            product.quantity >= 1 &&
                            product.quantity <= product.stock
                        ) {
                            total +=
                                product.price *
                                product.quantity;
                        }
                    }
                );

                orderTotal.textContent =
                    createOrderMoneyFormat.format(total);
            }

            /*
             * Preparar los campos que recibirá
             * OrderDetailsViewModel en el POST.
             */
            createOrderForm.addEventListener(
                "submit",
                function (event) {
                    productError.classList.add("d-none");

                    if (selectedOrderProducts.size === 0) {
                        event.preventDefault();

                        productError.textContent =
                            "Debes seleccionar al menos un producto.";

                        productError.classList.remove("d-none");

                        return;
                    }

                    const hasInvalidQuantity =
                        Array.from(
                            selectedOrderProducts.values()
                        ).some(function (product) {
                            return (
                                !Number.isInteger(product.quantity) ||
                                product.quantity < 1 ||
                                product.quantity > product.stock
                            );
                        });

                    if (hasInvalidQuantity) {
                        event.preventDefault();

                        productError.textContent =
                            "Una cantidad es inválida o supera la existencia disponible.";

                        productError.classList.remove("d-none");

                        return;
                    }

                    hiddenInputsContainer.replaceChildren();

                    let index = 0;

                    selectedOrderProducts.forEach(
                        function (product) {
                            appendHiddenInput(
                                `Products.Products[${index}].Id`,
                                product.id
                            );

                            appendHiddenInput(
                                `Products.Products[${index}].Quantity`,
                                product.quantity
                            );

                            index++;
                        }
                    );
                }
            );

            function appendHiddenInput(name, value) {
                const input =
                    document.createElement("input");

                input.type = "hidden";
                input.name = name;
                input.value = value;

                hiddenInputsContainer.appendChild(input);
            }

            /*
             * Limpiar todo cuando se cierre el modal.
             */
            createOrderModal.addEventListener(
                "hidden.bs.modal",
                function () {
                    selectedOrderProducts.clear();

                    createOrderForm.reset();

                    hiddenInputsContainer.replaceChildren();

                    productError.classList.add("d-none");

                    updateCreateOrderTotal();

                    productsDataTable
                        .search("")
                        .page(0)
                        .draw(false);
                }
            );

