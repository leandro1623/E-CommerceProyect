@model OrderDetailsViewModel

<div class="d-flex justify-content-center gap-2 flex-wrap order-actions"
     data-order-id="@Model.Id"
     data-order-number="@Model.OrderNumber"
     data-order-status="@Model.Status"
     data-customer-name="@Model.Customers.Name">
    <button type="button" class="btn btn-sm btn-outline-info"
            data-bs-toggle="modal" data-bs-target="#orderDetailsModal">
        Ver
    </button>
    <button type="button" class="btn btn-sm btn-outline-primary"
            data-bs-toggle="modal" data-bs-target="#editOrderModal">
        Cambiar estado
    </button>
    <button type="button" class="btn btn-sm btn-outline-danger"
            data-bs-toggle="modal" data-bs-target="#orderDetailsModal">
        Eliminar
    </button>
</div>
