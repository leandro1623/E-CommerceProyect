@using E_CommerceSite.Datos
@model CategoryViewModel

@{
    ViewData["Title"] = "Categorías";
}

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div id="deleteAlert"
         class="alert alert-success alert-dismissible fade show"
         role="alert">

        <strong>¡Listo!</strong> @successMessage

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Cerrar">
        </button>
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div id="deleteAlert"
         class="alert alert-danger alert-dismissible fade show"
         role="alert">

        <strong>¡Error!</strong> @errorMessage

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Cerrar">
        </button>
    </div>
}


<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="mb-1">Categorías</h2>

        <p class="text-muted mb-0">
            Administración de categorías registradas
        </p>
    </div>

    @* <a asp-action="Create"
       class="btn btn-primary">
        + Nueva categoría
    </a> *@

    @if(User.IsInRole(Constantes.Admin))
    {
        <button type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#createCategoryModal">
            + Nueva categoría
        </button>
    }


</div>

<div class="card border-0 shadow-sm">

    <div class="card-header bg-white py-3">
        <h5 class="mb-0">Lista de categorías</h5>
    </div>

    <div class="card-body">

        <div class="table-responsive">

            <table id="categoriesTable"
                   class="table table-striped table-hover align-middle w-100">

                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var category in Model.Categories)
                    {
                        <tr>
                            <td>
                                @category.Id
                            </td>

                            <td class="fw-semibold">
                                @category.Name
                            </td>

                            <td>
                                @category.Description
                            </td>

                            <td>
                                <div class="d-flex justify-content-center gap-1">

                                    <button type="button"
                                            class="btn btn-sm btn-outline-info"
                                            data-bs-toggle="modal"
                                            data-bs-target="#categoryInfoModal"
                                            data-category-id="@category.Id"
                                            data-category-name="@category.Name"
                                            data-category-description="@category.Description">
                                        Ver
                                    </button>

                                    @if (User.IsInRole(Constantes.Admin))
                                    {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editCategoryModal"
                                            data-category-id="@category.Id"
                                            data-category-name="@category.Name"
                                            data-category-description="@category.Description">
                                        Editar
                                    </button>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#categoryInfoModal"
                                            data-category-id="@category.Id"
                                            data-category-name="@category.Name"
                                            data-category-description="@category.Description">
                                        Eliminar
                                    </button>


                                    }
                                </div>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
        <partial name="CreateCategoryModal" model="Model" />
        <partial name="CategoryModals" modal="Model" />
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {

            new DataTable("#categoriesTable", {

                // Cantidad inicial de categorías
                pageLength: 10,

                // Opciones del selector
                lengthMenu: [5, 10, 25, 50, 100],

                // Ordenar por ID descendente
                order: [[0, "desc"]],

                // La columna de acciones no se ordena ni se busca
                columnDefs: [
                    {
                        targets: 3,
                        orderable: false,
                        searchable: false
                    }
                ],

                // Recordar página, búsqueda y orden
                stateSave: true,

                language: {
                    search: "Buscar:",
                    searchPlaceholder: "Buscar categorías...",

                    lengthMenu: "Mostrar _MENU_ categorías",

                    info: "Mostrando _START_ a _END_ de _TOTAL_ categorías",

                    infoEmpty: "No hay categorías registradas",

                    infoFiltered: "(filtrado de _MAX_ categorías)",

                    zeroRecords: "No se encontraron categorías",

                    emptyTable: "No hay categorías disponibles",

                    paginate: {
                        first: "Primero",
                        previous: "Anterior",
                        next: "Siguiente",
                        last: "Último"
                    }
                }
            });

            //Create category model
            const modal =
                document.getElementById("createCategoryModal");

            const form =
                document.getElementById("createCategoryForm");

            const button = document.getElementById("createCategoryFormButtonSubmit");

            modal.addEventListener("hidden.bs.modal", function() {
                form.reset();
            });
            
            form.addEventListener("submit", function () {
                button.disabled = true;
                button.textContent = "Guardando...";
            });
           

            //CategoryModals
              (() => {
            "use strict";

            function initializeCategoryModals() {
                const infoElement =
                    document.getElementById("categoryInfoModal");

                const editElement =
                    document.getElementById("editCategoryModal");

                const confirmationElement =
                    document.getElementById("confirmDeleteCategoryModal");

                if (!infoElement || !editElement || !confirmationElement) {
                    return;
                }

                // Evitar registrar los eventos más de una vez.
                if (infoElement.dataset.categoryModalsInitialized === "true") {
                    return;
                }

                infoElement.dataset.categoryModalsInitialized = "true";

                const infoModal =
                    bootstrap.Modal.getOrCreateInstance(infoElement);

                const confirmationModal =
                    bootstrap.Modal.getOrCreateInstance(confirmationElement);

                const editForm =
                    document.getElementById("editCategoryForm");

                const deleteForm =
                    document.getElementById("deleteCategoryForm");

                const deleteId =
                    document.getElementById("deleteCategoryId");

                const deleteSubmit =
                    document.getElementById("confirmDeleteCategorySubmit");

                let selectedCategory = null;
                let openConfirmationAfterHide = false;
                let deleteSubmitted = false;

                function readCategory(button) {
                    if (!button || !button.dataset.categoryId) {
                        return null;
                    }

                    return {
                        id: button.dataset.categoryId,
                        name: button.dataset.categoryName || "",
                        description:
                            button.dataset.categoryDescription || ""
                    };
                }

                // Cargar la información de la categoría seleccionada.
                infoElement.addEventListener("show.bs.modal", function (event) {
                    const category = readCategory(event.relatedTarget);

                    // Al regresar desde la confirmación se conserva la selección.
                    if (category) {
                        selectedCategory = category;
                    }

                    if (!selectedCategory) {
                        event.preventDefault();
                        return;
                    }

                    // document.getElementById("categoryInfoId").textContent =
                    //     selectedCategory.id;

                    document.getElementById("categoryInfoName").textContent =
                        selectedCategory.name;

                    document.getElementById("categoryInfoDescription").textContent =
                        selectedCategory.description.trim()
                            ? selectedCategory.description
                            : "Sin descripción.";
                });

                // Cerrar información para abrir la confirmación.
                document.getElementById("openDeleteCategoryConfirmation")
                    .addEventListener("click", function () {
                        if (!selectedCategory || openConfirmationAfterHide) {
                            return;
                        }

                        openConfirmationAfterHide = true;
                        infoModal.hide();
                    });

                // Si se pulsó durante la apertura, esperar a que termine.
                infoElement.addEventListener("shown.bs.modal", function () {
                    if (openConfirmationAfterHide) {
                        infoModal.hide();
                    }
                });

                // Abrir la confirmación después del cierre completo.
                infoElement.addEventListener("hidden.bs.modal", function () {
                    if (!openConfirmationAfterHide) {
                        return;
                    }

                    openConfirmationAfterHide = false;
                    confirmationModal.show();
                });

                // Preparar el formulario de eliminación.
                confirmationElement.addEventListener(
                    "show.bs.modal",
                    function (event) {
                        if (!selectedCategory) {
                            event.preventDefault();
                            return;
                        }

                        deleteId.value = selectedCategory.id;

                        document.getElementById("categoryDeleteName").textContent =
                            selectedCategory.name;

                        deleteSubmitted = false;
                        deleteSubmit.disabled = false;
                    }
                );

                // Cancelar, cerrar o presionar Escape devuelve a información.
                confirmationElement.addEventListener(
                    "hidden.bs.modal",
                    function () {
                        if (!deleteSubmitted && selectedCategory) {
                            infoModal.show();
                        }
                    }
                );

                // Cargar los campos del formulario de edición.
                editElement.addEventListener("show.bs.modal", function (event) {
                    const category = readCategory(event.relatedTarget);

                    if (!category) {
                        event.preventDefault();
                        return;
                    }

                    editForm.reset();

                    const validator = window.jQuery
                        ? window.jQuery(editForm).data("validator")
                        : null;

                    if (validator) {
                        validator.resetForm();
                    }

                    editForm.querySelectorAll(
                        ".input-validation-error, .is-invalid"
                    ).forEach(function (field) {
                        field.classList.remove(
                            "input-validation-error",
                            "is-invalid"
                        );
                    });

                    editForm.querySelectorAll("[data-valmsg-for]")
                        .forEach(function (message) {
                            message.textContent = "";
                            message.classList.remove("field-validation-error");
                            message.classList.add("field-validation-valid");
                        });

                    document.getElementById("editCategoryId").value =
                        category.id;

                    document.getElementById("editCategoryName").value =
                        category.name;

                    document.getElementById("editCategoryDescription").value =
                        category.description;
                });

                // Permitir un único envío del formulario de eliminación.
                deleteForm.addEventListener("submit", function (event) {
                    if (event.defaultPrevented) {
                        return;
                    }

                    if (!deleteId.value || deleteSubmitted) {
                        event.preventDefault();
                        return;
                    }

                    deleteSubmitted = true;
                    deleteSubmit.disabled = true;
                });
            }

            if (document.readyState === "loading") {
                document.addEventListener(
                    "DOMContentLoaded",
                    initializeCategoryModals,
                    { once: true }
                );
            } else {
                initializeCategoryModals();
            }
        })();

        });
    </script>
}