@using E_CommerceSite.Negocio.Services
@using Microsoft.AspNetCore.Identity
@inject IManageUser UserManager

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - E_CommerceSite</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.datatables.net/3.0.1/css/dataTables.bootstrap5.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/E-CommerceSite.styles.css"
          asp-append-version="true" />

</head>

<body class="@(User.Identity!.IsAuthenticated == false ? "sidebar-collapsed":" ")">

    @if (User.Identity?.IsAuthenticated == true)
        {
            <!-- MENÚ LATERAL FIJO -->
            <aside class="sidebar">

                <div class="sidebar-header">
                    <a asp-area=""
                    asp-controller="Home"
                    asp-action="Index">
                        E-Commerce
                    </a>
                </div>

                <nav class="sidebar-navigation">

                    <a asp-area=""
                    asp-controller="Home"
                    asp-action="Index">
                        <span>🏠</span>
                        Inicio
                    </a>

                    <a asp-area=""
                    asp-controller="Products"
                    asp-action="Index">
                        <span>📦</span>
                        Productos
                    </a>

                    <a asp-area=""
                    asp-controller="Category"
                    asp-action="Index">
                        <span>🏷️</span>
                        Categorías
                    </a>

                    <a asp-area=""
                    asp-controller="Orders"
                    asp-action="Index">
                        <span>🛒</span>
                        Pedidos
                    </a>

                    <a asp-area=""
                    asp-controller="Customer"
                    asp-action="Index">
                        <span>👥</span>
                        Clientes
                    </a>

                    <a asp-area=""
                    asp-controller="Home"
                    asp-action="Privacy">
                        <span>🔒</span>
                        Privacidad
                    </a>

                </nav>

                <div class="sidebar-footer">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var currentUser = await UserManager.GetUserManager().GetUserAsync(User);

                        var userName = currentUser?.Fullname
                                       ?? User.Identity?.Name
                                       ?? "Usuario";

                        var nameParts = userName.Split(' ', StringSplitOptions.RemoveEmptyEntries);

                        var initials = string.Concat(
                            nameParts
                                .Take(2)
                                .Select(part => char.ToUpper(part[0]))
                        );

                        <!-- USUARIO AUTENTICADO -->

                        <div class="sidebar-user">

                            <div class="sidebar-avatar">
                                @initials
                            </div>

                            <div class="sidebar-user-details">
                                <strong>@userName</strong>
                                <br />
                                <small>Usuario conectado</small>
                            </div>

                        </div>

                        <a asp-controller="Account"
                        asp-action="Profile"
                        class="sidebar-profile-button">
                            👤 Mi perfil
                        </a>

                        <form asp-controller="Account"
                        asp-action="Logout"
                        method="get">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                            class="sidebar-logout-button">
                                Cerrar sesión
                            </button>

                        </form>
                    }
                    else
                    {
                        <!-- USUARIO NO AUTENTICADO -->

                        <p class="sidebar-auth-text">
                            Accede a tu cuenta
                        </p>

                        <a asp-controller="Account"
                        asp-action="Login"
                        class="sidebar-login-button">
                            🔐 Iniciar sesión
                        </a>

                        <a asp-controller="Account"
                        asp-action="Register"
                        class="sidebar-register-button">
                            Crear una cuenta
                        </a>
                    }

                    <small class="sidebar-copyright">
                        &copy; 2026 E-Commerce
                    </small>

                </div>

            </aside>
        }

    <div id="sidebarOverlay" class="sidebar-overlay"></div>

    <!-- LADO DERECHO -->
    <div class="right-panel">
            @if(User.Identity!.IsAuthenticated == true)
            {
                <header class="top-header">
                    <button id="sidebarToggle"
                            class="sidebar-toggle"
                            type="button"
                            aria-label="Mostrar u ocultar menú">
                        ☰
                    </button>

                    <h1>@ViewData["Title"]</h1>
                </header>
            }

        <!-- Esta es la sección que se desplaza -->
        <main class="page-content" role="main">
            @RenderBody()
        </main>

        <footer class="page-footer">
            &copy; 2026 - E_CommerceSite -

            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">
                Privacidad
            </a>
        </footer>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.datatables.net/3.0.1/js/dataTables.min.js"></script>

    <script src="https://cdn.datatables.net/3.0.1/js/dataTables.bootstrap5.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>