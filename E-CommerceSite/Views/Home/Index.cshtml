@using System.Text.Json
@using E_CommerceSite.Models.Index
@model HomeIndexViewModel

@{
    ViewData["Title"] = "Panel principal";

    string salesLabelsJson = JsonSerializer.Serialize(
        Model.MonthlySales.Select(sale => sale.Label)
    );

    string salesValuesJson = JsonSerializer.Serialize(
        Model.MonthlySales.Select(sale => sale.Total)
    );

    string orderStatusLabelsJson = JsonSerializer.Serialize(
        Model.OrdersByStatus.Select(order => order.Status)
    );

    string orderStatusValuesJson = JsonSerializer.Serialize(
        Model.OrdersByStatus.Select(order => order.Quantity)
    );
}

<div class="container-fluid">

    <!-- Tarjetas de resumen -->
    <div class="row g-4 mb-4">

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">
                        Productos
                    </p>

                    <h2 class="fw-bold mb-0">
                        @Model.TotalProducts.ToString("N0")
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">
                        Clientes
                    </p>

                    <h2 class="fw-bold mb-0">
                        @Model.TotalCustomers.ToString("N0")
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">
                        Pedidos
                    </p>

                    <h2 class="fw-bold mb-0">
                        @Model.TotalOrders.ToString("N0")
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">
                        Ventas totales
                    </p>

                    <h2 class="fw-bold mb-0 text-primary">
                        RD$ @Model.TotalSales.ToString("N2")
                    </h2>
                </div>
            </div>
        </div>

    </div>

    <!-- Gráficos -->
    <div class="row g-4">

        <!-- Ventas mensuales -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        Ventas de los últimos 6 meses
                    </h5>
                </div>

                <div class="card-body">
                    <div style="height: 350px;">
                        <canvas id="salesChart"></canvas>
                    </div>
                </div>

            </div>
        </div>

        <!-- Pedidos por estado -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        Pedidos por estado
                    </h5>
                </div>

                <div class="card-body">

                    @if (Model.OrdersByStatus.Count > 0)
                    {
                        <div style="height: 350px;">
                            <canvas id="ordersChart"></canvas>
                        </div>
                    }
                    else
                    {
                        <div class="h-100 d-flex align-items-center justify-content-center">
                            <p class="text-muted mb-0">
                                No hay pedidos registrados.
                            </p>
                        </div>
                    }

                </div>

            </div>
        </div>

    </div>

</div>

@section Scripts {

    <script>
        const salesLabels =
            @Html.Raw(salesLabelsJson);

        const salesValues =
            @Html.Raw(salesValuesJson);

        const orderStatusLabels =
            @Html.Raw(orderStatusLabelsJson);

        const orderStatusValues =
            @Html.Raw(orderStatusValuesJson);

        /*
         * Gráfico de ventas mensuales.
         */
        const salesCanvas =
            document.getElementById("salesChart");

        new Chart(salesCanvas, {
            type: "line",

            data: {
                labels: salesLabels,

                datasets: [{
                    label: "Ventas en RD$",
                    data: salesValues,
                    borderColor: "#0d6efd",
                    backgroundColor: "rgba(13, 110, 253, 0.15)",
                    borderWidth: 3,
                    tension: 0.3,
                    fill: true
                }]
            },

            options: {
                responsive: true,
                maintainAspectRatio: false,

                interaction: {
                    intersect: false,
                    mode: "index"
                },

                scales: {
                    y: {
                        beginAtZero: true,

                        ticks: {
                            callback: function (value) {
                                return "RD$ " +
                                    Number(value).toLocaleString("es-DO");
                            }
                        }
                    }
                },

                plugins: {
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                const value = Number(context.raw);

                                return "Ventas: RD$ " +
                                    value.toLocaleString("es-DO", {
                                        minimumFractionDigits: 2,
                                        maximumFractionDigits: 2
                                    });
                            }
                        }
                    }
                }
            }
        });

        /*
         * Devuelve un color dependiendo del estado.
         */
        function getOrderStatusColor(status) {
            const normalizedStatus =
                status.toLowerCase().trim();

            switch (normalizedStatus) {
                case "completado":
                case "completados":
                case "completed":
                    return "#198754";

                case "pendiente":
                case "pendientes":
                case "pending":
                    return "#ffc107";

                case "cancelado":
                case "cancelados":
                case "cancelled":
                case "canceled":
                    return "#dc3545";

                case "procesando":
                case "processing":
                    return "#0d6efd";

                default:
                    return "#6c757d";
            }
        }

        /*
         * Gráfico de pedidos por estado.
         */
        const ordersCanvas =
            document.getElementById("ordersChart");

        if (ordersCanvas) {
            const orderStatusColors =
                orderStatusLabels.map(getOrderStatusColor);

            new Chart(ordersCanvas, {
                type: "doughnut",

                data: {
                    labels: orderStatusLabels,

                    datasets: [{
                        data: orderStatusValues,
                        backgroundColor: orderStatusColors,
                        borderWidth: 0
                    }]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,

                    plugins: {
                        legend: {
                            position: "bottom"
                        }
                    }
                }
            });
        }
    </script>
}