@{
}

<div class="modal fade"
     id="customerDetailsModal"
     tabindex="-1"
     aria-labelledby="customerDetailsModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="customerDetailsModalLabel">
                    Detalles del cliente
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>
            </div>

            <div class="modal-body">

                <div class="mb-3">
                    <small class="text-muted">Nombre completo</small>
                    <p id="detailsCustomerName"
                       class="fw-semibold mb-0">
                    </p>
                </div>

                <div class="mb-3">
                    <small class="text-muted">Correo electrónico</small>
                    <p id="detailsCustomerEmail" class="mb-0"></p>
                </div>

                <div class="mb-3">
                    <small class="text-muted">Teléfono</small>
                    <p id="detailsCustomerPhone" class="mb-0"></p>
                </div>

                <div class="mb-3">
                    <small class="text-muted">Dirección</small>
                    <p id="detailsCustomerAddress" class="mb-0"></p>
                </div>

                <div class="mb-3">
                    <small class="text-muted">Fecha de registro</small>
                    <p id="detailsCustomerCreatedAt" class="mb-0"></p>
                </div>

                <div>
                    <small class="text-muted d-block mb-1">Estado</small>
                    <span id="detailsCustomerStatus" class="badge"></span>
                </div>

            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cerrar
                </button>

                <button type="button"
                        id="openDeleteConfirmation"
                        class="btn btn-danger">
                    Eliminar cliente
                </button>
            </div>

        </div>
    </div>
</div>
