@model E_CommerceSite.Models.CustomerViewModel

@{
    ViewData["Title"] = "Clientes";
}

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div id="deleteAlert"
         class="alert alert-success alert-dismissible fade show"
         role="alert">

        <strong>¡Listo!</strong> @successMessage

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Cerrar">
        </button>
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div id="deleteAlert"
         class="alert alert-danger alert-dismissible fade show"
         role="alert">

        <strong>¡Error!</strong> @errorMessage

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Cerrar">
        </button>
    </div>
}


<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="mb-1">Clientes</h2>

        <p class="text-muted mb-0">
            Administración de clientes registrados
        </p>
    </div>

        <a  asp-action="Register" asp-controller="Account"
            class="btn btn-primary disabled">
          + Nuevo cliente
        </a>

</div> 

<!-- Tarjetas informativas -->

<div class="row g-3 mb-4">

    <div class="col-sm-6 col-xl-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">

                <p class="text-muted mb-2">
                    Total de clientes
                </p>

                <h3 class="fw-bold mb-0">
                    @Model.Customers.Count()
                </h3>

            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">

                <p class="text-muted mb-2">
                    Clientes activos
                </p>

                <h3 class="fw-bold text-success mb-0">
                    @Model.Customers.Count(customer => customer.IsActive)
                </h3>

            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">

                <p class="text-muted mb-2">
                    Clientes inactivos
                </p>

                <h3 class="fw-bold text-danger mb-0">
                    @Model.Customers.Count(customer => !customer.IsActive)
                </h3>

            </div>
        </div>
    </div>

</div>

<!-- Tabla de clientes -->

<div class="card border-0 shadow-sm">

    <div class="card-header bg-white py-3">
        <h5 class="mb-0">Lista de clientes</h5>
    </div>

    <div class="card-body">

        <div class="table-responsive">

            <table id="customersTable"
                   class="table table-striped table-hover align-middle w-100">

                <thead class="table-dark">
                    <tr>
                        <th>Nombre</th>
                        <th>Correo electrónico</th>
                        <th>Teléfono</th>
                        <th>Fecha de registro</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var customer in Model.Customers)
                    {
                        <tr>

                            <td class="fw-semibold">
                                @customer.Name
                            </td>

                            <td>
                                <a href="mailto:@customer.Email"
                                   class="text-decoration-none">
                                    @customer.Email
                                </a>
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(customer.Phone))
                                {
                                    <a href="tel:@customer.Phone"
                                       class="text-decoration-none text-dark">
                                        @customer.Phone
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No registrado
                                    </span>
                                }
                            </td>

                            <td data-order="@customer.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")">
                                @customer.CreatedAt.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @if (customer.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Inactivo
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="d-flex justify-content-center gap-1">

                                    @* <a asp-action="Details"
                                       asp-route-id="@customer.Id"
                                       class="btn btn-sm btn-outline-info">
                                        Ver
                                    </a> *@

                                    <button type="button"
                                            class="btn btn-info btn-sm"
                                            data-bs-toggle="modal"
                                            data-bs-target="#customerDetailsModal"
                                            data-id="@customer.Id"
                                            data-name="@customer.Name"
                                            data-email="@customer.Email"
                                            data-phone="@(customer.Phone ?? "No especificado")"
                                            data-address="@(customer.Address ?? "No especificada")"
                                            data-created-at="@customer.CreatedAt.ToString("dd/MM/yyyy HH:mm")"
                                            data-active="@customer.IsActive.ToString().ToLower()">
                                        Ver
                                    </button>

                                    @* <a asp-action="Edit"
                                       asp-route-id="@customer.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Editar
                                    </a> *@

                                    <button type="button"
                                            class="btn btn-warning btn-sm"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editCustomerModal"
                                            data-id="@customer.Id"
                                            data-name="@customer.Name"
                                            data-email="@customer.Email"
                                            data-phone="@customer.Phone"
                                            data-address="@customer.Address"
                                            data-active="@customer.IsActive.ToString().ToLower()">
                                        Editar
                                    </button>

                                    <button type="button"
                                            class="btn btn-danger btn-sm"
                                            data-bs-toggle="modal"
                                            data-bs-target="#customerDetailsModal"
                                            data-id="@customer.Id"
                                            data-name="@customer.Name"
                                            data-email="@customer.Email"
                                            data-phone="@(customer.Phone ?? "No especificado")"
                                            data-address="@(customer.Address ?? "No especificada")"
                                            data-created-at="@customer.CreatedAt.ToString("dd/MM/yyyy HH:mm")"
                                            data-active="@customer.IsActive.ToString().ToLower()">
                                        Eliminar
                                    </button>

                                </div>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            <partial name="DetailsModal" model="Model" />
            <partial name="ConfirmDeletionModal" model="Model" />
            <partial name="EditModal" model="new EditarCustomerViewModel(){
                Id = Model.Id,
                Name = Model.Name,
                Email = Model.Email,
                Address = Model.Address,
                IsActive = Model.IsActive,
                Phone = Model.Phone
            }"/>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {

            new DataTable("#customersTable", {

                pageLength: 10,

                lengthMenu: [5, 10, 25, 50, 100],

                // Clientes más recientes primero
                order: [[3, "desc"]],

                columnDefs: [
                    {
                        // Columna Acciones
                        targets: 5,
                        orderable: false,
                        searchable: false
                    }
                ],

                stateSave: true,

                language: {
                    search: "Buscar:",
                    searchPlaceholder: "Nombre, correo o teléfono...",

                    lengthMenu: "Mostrar _MENU_ clientes",

                    info: "Mostrando _START_ a _END_ de _TOTAL_ clientes",

                    infoEmpty: "No hay clientes registrados",

                    infoFiltered: "(filtrado de _MAX_ clientes)",

                    zeroRecords: "No se encontraron clientes",

                    emptyTable: "No hay clientes disponibles",

                    paginate: {
                        first: "Primero",
                        previous: "Anterior",
                        next: "Siguiente",
                        last: "Último"
                    }
                }
            });

            // const successAlert =
            //     document.getElementById("deleteAlert");

            // if (successAlert) {
            //     setTimeout(function() {
            //         successAlert.classList.remove("show");

            //         setTimeout(function() {
            //             successAlert.remove();
            //         }, 200);
            //     }, 5000);
            // }

            const detailsModalElement =
                document.getElementById("customerDetailsModal");

            const confirmationModalElement =
                document.getElementById("deleteConfirmationModal");

            const detailsModal =
                bootstrap.Modal.getOrCreateInstance(detailsModalElement);

            const confirmationModal =
                bootstrap.Modal.getOrCreateInstance(
                    confirmationModalElement
                );

            const customerIdInput =
                document.getElementById("deleteCustomerId");

            const customerNameConfirmation =
                document.getElementById("deleteCustomerName");

            const deleteForm =
                document.getElementById("deleteCustomerForm");

            let deleteSubmitted = false;

            // Completar el modal cuando se presiona Ver o Eliminar.
            detailsModalElement.addEventListener(
                "show.bs.modal",
                function(event) {
                    const button = event.relatedTarget;

                    // Cuando regresamos desde el modal de confirmación,
                    // no existe relatedTarget y conservamos los datos.
                    if (!button) {
                        return;
                    }

                    const customerId = button.dataset.id;
                    const customerName = button.dataset.name;
                    const isActive = button.dataset.active === "true";

                    document.getElementById(
                        "detailsCustomerName"
                    ).textContent = customerName;

                    document.getElementById(
                        "detailsCustomerEmail"
                    ).textContent = button.dataset.email;

                    document.getElementById(
                        "detailsCustomerPhone"
                    ).textContent = button.dataset.phone;

                    document.getElementById(
                        "detailsCustomerAddress"
                    ).textContent = button.dataset.address;

                    document.getElementById(
                        "detailsCustomerCreatedAt"
                    ).textContent = button.dataset.createdAt;

                    const status =
                        document.getElementById(
                            "detailsCustomerStatus"
                        );

                    status.textContent =
                        isActive ? "Activo" : "Inactivo";

                    status.className =
                        isActive
                            ? "badge bg-success"
                            : "badge bg-danger";

                    // Guardar los datos para la eliminación.
                    customerIdInput.value = customerId;
                    customerNameConfirmation.textContent = customerName;
                }
            );

            // Pasar del modal de detalles al de confirmación.
            document.getElementById(
                "openDeleteConfirmation"
            ).addEventListener("click", function() {
                deleteSubmitted = false;

                detailsModalElement.addEventListener(
                    "hidden.bs.modal",
                    function() {
                        confirmationModal.show();
                    },
                    { once: true }
                );

                detailsModal.hide();
            });

            // Cancelar y regresar al modal anterior.
            document.getElementById(
                "cancelCustomerDelete"
            ).addEventListener("click", function() {
                confirmationModal.hide();
            });

            // También regresa al modal anterior si se presiona
            // la X, Escape o fuera del modal de confirmación.
            confirmationModalElement.addEventListener(
                "hidden.bs.modal",
                function() {
                    if (!deleteSubmitted) {
                        detailsModal.show();
                    }
                }
            );

            // Evita regresar al modal anterior cuando se confirma.
            deleteForm.addEventListener("submit", function() {
                deleteSubmitted = true;
            });

            const editCustomerModal =
                document.getElementById("editCustomerModal");

            editCustomerModal.addEventListener(
                "show.bs.modal",
                function(event) {
                    const button = event.relatedTarget;

                    if (!button) {
                        return;
                    }

                    document.getElementById(
                        "editCustomerId"
                    ).value = button.dataset.id;

                    document.getElementById(
                        "editCustomerName"
                    ).value = button.dataset.name;

                    document.getElementById(
                        "editCustomerEmail"
                    ).value = button.dataset.email;

                    document.getElementById(
                        "editCustomerPhone"
                    ).value = button.dataset.phone || "";

                    document.getElementById(
                        "editCustomerAddress"
                    ).value = button.dataset.address || "";

                    document.getElementById(
                        "editCustomerIsActive"
                    ).checked = button.dataset.active === "true";
                }
            );

        });

    </script>
    <partial name="_ValidationScriptsPartial" />
}