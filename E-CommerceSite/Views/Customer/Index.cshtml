@model IEnumerable<E_CommerceSite.Models.Customer>

@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="mb-1">Clientes</h2>

        <p class="text-muted mb-0">
            Administración de clientes registrados
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        + Nuevo cliente
    </a>

</div>

<!-- Tarjetas informativas -->

<div class="row g-3 mb-4">

    <div class="col-sm-6 col-xl-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">

                <p class="text-muted mb-2">
                    Total de clientes
                </p>

                <h3 class="fw-bold mb-0">
                    @Model.Count()
                </h3>

            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">

                <p class="text-muted mb-2">
                    Clientes activos
                </p>

                <h3 class="fw-bold text-success mb-0">
                    @Model.Count(customer => customer.IsActive)
                </h3>

            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">

                <p class="text-muted mb-2">
                    Clientes inactivos
                </p>

                <h3 class="fw-bold text-danger mb-0">
                    @Model.Count(customer => !customer.IsActive)
                </h3>

            </div>
        </div>
    </div>

</div>

<!-- Tabla de clientes -->

<div class="card border-0 shadow-sm">

    <div class="card-header bg-white py-3">
        <h5 class="mb-0">Lista de clientes</h5>
    </div>

    <div class="card-body">

        <div class="table-responsive">

            <table id="customersTable"
                   class="table table-striped table-hover align-middle w-100">

                <thead class="table-dark">
                    <tr>
                        <th>Nombre</th>
                        <th>Correo electrónico</th>
                        <th>Teléfono</th>
                        <th>Fecha de registro</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var customer in Model)
                    {
                        <tr>

                            <td class="fw-semibold">
                                @customer.Name
                            </td>

                            <td>
                                <a href="mailto:@customer.Email"
                                   class="text-decoration-none">
                                    @customer.Email
                                </a>
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(customer.Phone))
                                {
                                    <a href="tel:@customer.Phone"
                                       class="text-decoration-none text-dark">
                                        @customer.Phone
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No registrado
                                    </span>
                                }
                            </td>

                            <td data-order="@customer.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")">
                                @customer.CreatedAt.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @if (customer.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Inactivo
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="d-flex justify-content-center gap-1">

                                    <a asp-action="Details"
                                       asp-route-id="@customer.Id"
                                       class="btn btn-sm btn-outline-info">
                                        Ver
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@customer.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Editar
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@customer.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        Eliminar
                                    </a>

                                </div>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {

            new DataTable("#customersTable", {

                pageLength: 10,

                lengthMenu: [5, 10, 25, 50, 100],

                // Clientes más recientes primero
                order: [[3, "desc"]],

                columnDefs: [
                    {
                        // Columna Acciones
                        targets: 5,
                        orderable: false,
                        searchable: false
                    }
                ],

                stateSave: true,

                language: {
                    search: "Buscar:",
                    searchPlaceholder: "Nombre, correo o teléfono...",

                    lengthMenu: "Mostrar _MENU_ clientes",

                    info: "Mostrando _START_ a _END_ de _TOTAL_ clientes",

                    infoEmpty: "No hay clientes registrados",

                    infoFiltered: "(filtrado de _MAX_ clientes)",

                    zeroRecords: "No se encontraron clientes",

                    emptyTable: "No hay clientes disponibles",

                    paginate: {
                        first: "Primero",
                        previous: "Anterior",
                        next: "Siguiente",
                        last: "Último"
                    }
                }
            });

        });
    </script>
}